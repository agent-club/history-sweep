{
  "name": "history-sweep",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs extension/tests/history-utils.test.mjs",
    "test:browser": "node scripts/verify.mjs",
    "test:site": "node scripts/verify-site.mjs",
    "test:features": "node scripts/verify-features.mjs",
    "test:native": "node scripts/verify-native.mjs",
    "test:toolbar": "node scripts/verify-toolbar.mjs",
    "test:config-sync": "node scripts/verify-config-sync.mjs",
    "test:soft-privacy": "node scripts/verify-soft-privacy.mjs",
    "test:preferences-close": "node scripts/verify-preferences-close.mjs",
    "notes:generate": "node scripts/generate-release-notes.mjs",
    "test:help": "node scripts/verify-help.mjs",
    "assets": "node scripts/assets.mjs",
    "assets:store": "node scripts/capture-store-screenshots.mjs",
    "render:opening": "node scripts/render-opening.mjs",
    "build": "node scripts/build.mjs",
    "deploy:site": "wrangler deploy site --name history-sweep --domain sweep.agentclub.dev --compatibility-date 2026-09-18",
    "test:release": "node scripts/verify-release.mjs",
    "test:updates": "node scripts/verify-updates.mjs",
    "test:packages": "node scripts/verify-packages.mjs",
    "test:workspace-tools": "node scripts/verify-workspace-tools.mjs",
    "test:design-refinements": "node scripts/verify-design-refinements.mjs",
    "test:ui-row-actions": "python3 scripts/check-ui-row-actions.py",
    "test:ui-row-actions:regression": "node scripts/verify-ui-row-actions-regression.mjs"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "playwright": "1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.532",
    "sharp": "0.35.4",
    "wrangler": "^4.135.0"
  }
}

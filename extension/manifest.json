{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "name": "History Sweep",
  "version": "0.6.0",
  "default_locale": "en",
  "options_ui": { "page": "sync.html", "open_in_tab": true },
  "optional_host_permissions": ["https://*/*"],
  "description": "__MSG_description__",
  "permissions": [
    "history",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "favicon",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "History Sweep",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+H",
        "windows": "Alt+H",
        "mac": "Option+H"
      }
    }
  },
  "web_accessible_resources": [{
    "resources": ["modal.html"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https:"
  }
}
